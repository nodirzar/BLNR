{
  "expo": {
    "name": "BLNR — карманный стилист",
    "slug": "blnr-stylist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "blnr",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.blnr.stylist",
      "infoPlist": {
        "NSCameraUsageDescription": "Камера нужна, чтобы фотографировать одежду для вашего гардероба.",
        "NSPhotoLibraryUsageDescription": "Доступ к галерее нужен, чтобы добавлять фото одежды.",
        "NSLocationWhenInUseUsageDescription": "Геолокация нужна, чтобы подбирать образы под погоду в вашем городе."
      }
    },
    "android": {
      "package": "com.blnr.stylist",
      "adaptiveIcon": {
        "backgroundColor": "#12100D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12100D",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Камера нужна, чтобы фотографировать одежду для вашего гардероба."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Геолокация нужна, чтобы подбирать образы под погоду в вашем городе."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
